# Configuración de docker compose (se carga automáticamente).
# Valores solo para desarrollo local.

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres con mayúsculas,
# minúsculas, números y/o símbolos). Se fija al crear la BD por primera vez: si la
# cambias después, ejecuta "docker compose down -v" para recrearla.
MSSQL_SA_PASSWORD=Nexus2026_Pass

# Imagen de la app: Dockerfile (nativo GraalVM 25 + Distroless) o Dockerfile.jvm (Temurin 25 + ZGC)
APP_DOCKERFILE=Dockerfile

# Usuario y contraseña del administrador (interfaz web y API de gestión, HTTP Basic)
ADMIN_USER=admin
ADMIN_PASSWORD=Nexus2026_Admin

# Clave con la que el Recolector se autentica ante el Core Bancario (cabecera X-API-Key)
CORE_API_KEY=nexus-core-api-key-desarrollo

# Puertos publicados en tu PC (localhost). Cámbialos si alguno ya está ocupado.
APP_HTTP_PORT=8087
APP_TCP_PORT=15000
SQLSERVER_PORT=14333

# Zona horaria de los contenedores (fecha/hora de las transacciones)
TZ=America/Guatemala
