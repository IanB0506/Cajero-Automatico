# =====================================================================
# Apache JMeter 5.6.3 para la prueba de carga ISO 8583
#
#   docker compose --profile carga run --rm jmeter
#
# Corre sobre Java 21: el Groovy 3 que trae JMeter 5.6.3 no soporta Java 25,
# así que los scripts del plan fallarían con un JMeter ejecutado sobre Java 25.
# El reporte HTML queda en ./reportes/jmeter/html/index.html
# =====================================================================
FROM eclipse-temurin:21-jre

ARG JMETER_VERSION=5.6.3
# SHA-512 publicado por Apache para apache-jmeter-5.6.3.tgz
ARG JMETER_SHA512=5978a1a35edb5a7d428e270564ff49d2b1b257a65e17a759d259a9283fc17093e522fe46f474a043864aea6910683486340706d745fcdf3db1505fd71e689083

RUN curl -fsSL -o /tmp/jmeter.tgz "https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz" \
 && echo "${JMETER_SHA512}  /tmp/jmeter.tgz" | sha512sum -c - \
 && tar -xzf /tmp/jmeter.tgz -C /opt \
 && rm /tmp/jmeter.tgz

ENV PATH=/opt/apache-jmeter-${JMETER_VERSION}/bin:$PATH
ENV JVM_ARGS="-Xms1g -Xmx1g"

COPY src/test/resources/load-test-iso8583.jmx /plan/load-test-iso8583.jmx

# Los argumentos de "docker compose run" (-Jterminales=..., -Jduracion=...) se agregan al final
ENTRYPOINT ["/bin/sh", "-c", "rm -rf /reportes/jmeter && mkdir -p /reportes/jmeter && exec jmeter -n -t /plan/load-test-iso8583.jmx -l /reportes/jmeter/resultados.jtl -j /reportes/jmeter/jmeter.log -e -o /reportes/jmeter/html \"$@\"", "jmeter"]
